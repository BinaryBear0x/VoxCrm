@model VoxCrm.Web.Services.TransferStage
@using VoxCrm.Web.Services
@{ ViewData["Title"]="Excel sütun eşleştirme"; ViewData["ActiveMenu"]="excel"; }
<partial name="_TransferAlerts" />
<h1>Sütunları eşleştirin</h1><p>Dosyanızın ilk sayfasında @Model.Rows.Count satır var. Tarihler için yyyy-AA-gg veya gg.AA.yyyy kullanın. Henüz kayıt yapılmadı.</p>
<form asp-action="Preview" method="post"><input type="hidden" name="token" value="@ViewBag.Token"/><div class="row g-3">@for(var i=0;i<ExcelTransferService.Headers.Length;i++){var field=i;var match=Array.FindIndex(Model.Headers,h=>ExcelTransferService.Norm(h)==ExcelTransferService.Norm(ExcelTransferService.Headers[field])||ExcelTransferService.Aliases[field].Any(a=>ExcelTransferService.Norm(a)==ExcelTransferService.Norm(h)));<div class="col-md-4"><label class="form-label" for="col-@i">@ExcelTransferService.Headers[i] @(new[]{0,2,3,4}.Contains(i)?"*":"")</label><select id="col-@i" class="form-select" name="columns"><option value="-1">Aktarma</option>@for(var j=0;j<Model.Headers.Length;j++){<option value="@j" selected="@(j==match)">@(j+1). @Model.Headers[j]</option>}</select></div>}</div><div class="mt-4 d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a><button class="btn btn-primary">Önizleme ve mükerrer kontrolü</button></div></form>
<h2 class="h5 mt-4">Dosyadaki ilk 3 satır</h2><div class="table-responsive"><table class="table small"><thead><tr>@foreach(var h in Model.Headers){<th>@h</th>}</tr></thead><tbody>@foreach(var row in Model.Rows.Take(3)){<tr>@foreach(var cell in row){<td>@cell</td>}</tr>}</tbody></table></div>
