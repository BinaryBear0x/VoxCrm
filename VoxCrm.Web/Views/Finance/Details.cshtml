@model VoxCrm.Application.Finance.FinanceDetailsModel
@using VoxCrm.Domain.Entities
@{ var a = Model.Account; ViewData["Title"] = a.CustomerName + " · Borç ve Tahsilat"; ViewData["ActiveMenu"] = "finance"; }
<a asp-action="Index" class="text-muted">← Borç ve Tahsilat</a>
<div class="d-flex justify-content-between align-items-start gap-3 my-3"><div><h1 class="h3">@a.CustomerName</h1><p>@a.Description</p><span class="text-muted">@(a.PetOwnerId.HasValue ? "Kayıtlı müşteri" : "Manuel kayıt") @(Model.PatientName == null ? "" : " · " + Model.PatientName)</span></div>
@if (a.IsActive) { <div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@a.ID" class="btn btn-outline-primary">Düzenle</a><form asp-action="Delete" method="post" data-confirm="Bu borç kaydını ve içindeki kalemleri listeden silmek istiyor musunuz? İşlem geçmişi saklanır."><input type="hidden" name="id" value="@a.ID" /><input type="hidden" name="revision" value="@a.Revision" /><button class="btn btn-outline-danger">Kaydı sil</button></form></div> }
</div>
<partial name="_Messages" />
@if (!a.IsActive) { <div class="alert alert-secondary">Bu kayıt @a.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") tarihinde silindi. Aşağıdaki bilgiler silinme anındaki kayıt ve işlem geçmişidir.</div> }
<div class="row g-3 mb-4">@foreach (var item in new[] { ("Toplam borç", Model.Total), ("Ödenen", Model.Paid), ("Kalan", Model.Remaining), ("Taksit dışı kalan", Model.Unplanned) }) { <div class="col-6 col-lg-3"><div class="card card-body"><span class="small text-muted">@item.Item1</span><strong class="fs-4">@item.Item2.ToString("N2") TL</strong></div></div> }</div>
<p class="text-muted small">Taksit dışı bakiyenin son ödeme tarihi: @a.DueDate.ToString("dd.MM.yyyy"). Taksitlerin her biri kendi vadesiyle takip edilir.</p>
<section class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Borç kalemleri</h2>@if(a.IsActive) { <a asp-action="Entry" asp-route-accountId="@a.ID" asp-route-kind="charge" class="btn btn-sm btn-primary">Borca ekle</a> }</div><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Tarih</th><th>Açıklama</th><th>Tutar</th><th></th></tr></thead><tbody>
@foreach (var c in a.Charges.Where(x => x.IsActive).OrderByDescending(x => x.ChargeDate)) { <tr><td>@c.ChargeDate.ToString("dd.MM.yyyy")</td><td>@c.Description</td><td>@c.Amount.ToString("N2") TL</td><td>@if(a.IsActive) { <partial name="_EntryActions" model="@(new VoxCrm.Web.Models.FinanceEntryActions(a.ID, c.ID, "charge", a.Revision))" /> }</td></tr> }
@if(!a.Charges.Any(x => x.IsActive)) { <tr><td colspan="4" class="p-3 text-muted">Borç kalemi yok.</td></tr> }
</tbody></table></div></section>
<section class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Taksit planı</h2>@if(a.IsActive) { <a asp-action="Entry" asp-route-accountId="@a.ID" asp-route-kind="installment" class="btn btn-sm btn-outline-primary">Taksit ekle</a> }</div>
@if(a.IsActive && Model.Unplanned > 0) { <div class="card-body border-bottom"><form asp-action="GenerateInstallments" method="post" class="row g-2 align-items-end"><input type="hidden" name="accountId" value="@a.ID" /><input type="hidden" name="revision" value="@a.Revision" /><div class="col-md-4"><label for="planCount" class="form-label">Kalan @Model.Unplanned.ToString("N2") TL için taksit sayısı</label><input id="planCount" type="number" name="count" value="3" min="1" max="60" required class="form-control" /></div><div class="col-md-4"><label for="planDate" class="form-label">İlk taksit tarihi</label><input id="planDate" type="date" name="firstDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" /></div><div class="col-md-4"><button class="btn btn-outline-primary">Aylık taksitlere böl</button></div></form></div> }
<div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Vade / Taksit</th><th>Tutar</th><th>Ödenen / Kalan</th><th>Durum</th><th></th></tr></thead><tbody>
@foreach(var i in a.Installments.Where(x => x.IsActive).OrderBy(x => x.DueDate)) { var paid = Model.PaidFor(i.ID); var left = i.Amount - paid;
<tr><td>@i.DueDate.ToString("dd.MM.yyyy")<div class="small text-muted">@i.Description</div></td><td>@i.Amount.ToString("N2") TL</td><td>@paid.ToString("N2") / @left.ToString("N2") TL</td><td>@(left == 0 ? "Ödendi" : i.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "Vadesi geçti" : paid > 0 ? "Kısmen ödendi" : "Bekliyor")</td><td>@if(a.IsActive) { <partial name="_EntryActions" model="@(new VoxCrm.Web.Models.FinanceEntryActions(a.ID, i.ID, "installment", a.Revision))" /> }</td></tr> }
@if(!a.Installments.Any(x => x.IsActive)) { <tr><td colspan="5" class="p-3 text-muted">Taksit planı yok. Borcun tamamı taksit dışı bakiye olarak takip edilir.</td></tr> }
</tbody></table></div><div class="card-footer small text-muted">Taksit silindiğinde yapılmış ödemeler silinmez; taksit bağlantıları kaldırılır.</div></section>
<section class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Yapılan ödemeler</h2>@if(a.IsActive) { <a asp-action="Entry" asp-route-accountId="@a.ID" asp-route-kind="receipt" class="btn btn-sm btn-success">Ödeme ekle</a> }</div><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Ödeme tarihi</th><th>Tutar</th><th>Yöntem / Taksit</th><th>Not</th><th></th></tr></thead><tbody>
@foreach(var r in a.Receipts.Where(x => x.IsActive).OrderByDescending(x => x.PaidDate)) { <tr><td>@r.PaidDate.ToString("dd.MM.yyyy")</td><td>@r.Amount.ToString("N2") TL</td><td>@r.PaymentMethod<div class="small text-muted">@(a.Installments.FirstOrDefault(x => x.ID == r.FinanceInstallmentId)?.Description ?? "Taksit dışı ödeme")</div></td><td>@r.Notes</td><td>@if(a.IsActive) { <partial name="_EntryActions" model="@(new VoxCrm.Web.Models.FinanceEntryActions(a.ID, r.ID, "receipt", a.Revision))" /> }</td></tr> }
@if(!a.Receipts.Any(x => x.IsActive)) { <tr><td colspan="5" class="p-3 text-muted">Henüz ödeme girilmedi.</td></tr> }
</tbody></table></div></section>
<section class="card mb-4"><div class="card-header"><h2 class="h5 mb-0">İşlem geçmişi</h2></div><div class="card-body">
@foreach(var h in a.Changes.OrderByDescending(x => x.CreatedAt)) { <details class="border-bottom py-2"><summary><strong>@h.Action</strong> · @h.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") · @h.ActorName</summary><dl class="row small mt-2 mb-0"><dt class="col-md-2">Önce</dt><dd class="col-md-10"><pre class="text-wrap mb-0">@(h.BeforeJson ?? "—")</pre></dd><dt class="col-md-2">Sonra</dt><dd class="col-md-10"><pre class="text-wrap mb-0">@(h.AfterJson ?? "—")</pre></dd></dl></details> }
@if(!a.Changes.Any()) { <p class="text-muted mb-0">Geçmiş kaydı yok.</p> }
</div></section>
