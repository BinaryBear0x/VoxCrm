@model VoxCrm.Application.Workday.PublicFollowUp
@using System.Globalization
@{
    Layout = null;
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var next = Model.ShowVaccinations ? Model.Patients.SelectMany(p => p.Vaccines.Where(v => v.Current && v.Next >= Model.Today).Select(v => new { Patient = p.Name, Vaccine = v })).OrderBy(x => x.Vaccine.Next).FirstOrDefault() : null;
    var phone = string.IsNullOrWhiteSpace(Model.Phone) ? null : new string(Model.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
}
<!DOCTYPE html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#f6f8f5"><title>Hayvanlarım — @Model.ClinicName</title><link rel="stylesheet" href="/css/owner-followup.css" asp-append-version="true"></head>
<body class="owner-track-shell">
<svg class="ot-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><symbol id="ot-paw" viewBox="0 0 24 24"><ellipse cx="5" cy="8" rx="2.2" ry="3"/><ellipse cx="10" cy="5" rx="2.2" ry="3"/><ellipse cx="16" cy="5.8" rx="2.2" ry="3"/><ellipse cx="20" cy="10" rx="2.1" ry="2.8"/><path d="M5 17c0-3 4-7 7-7s7 4 7 7c0 5-5 2-7 2s-7 3-7-2Z"/></symbol><symbol id="ot-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h2m4 0h2"/></symbol><symbol id="ot-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol><symbol id="ot-phone" viewBox="0 0 24 24"><path d="m7 3 3 5-3 3c2 3 3 4 6 6l3-3 5 3c-1 5-4 5-8 3C7 17 3 13 2 7c0-3 2-4 5-4Z"/></symbol><symbol id="ot-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol><symbol id="ot-heart" viewBox="0 0 24 24"><path d="M20 5c-3-3-7-1-8 1-2-3-6-4-9-1-4 5 3 11 9 16 6-5 12-11 8-16Z"/></symbol><symbol id="ot-shield" viewBox="0 0 24 24"><path d="m12 3 8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></symbol><symbol id="ot-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></symbol></svg>
<a class="ot-skip" href="#pets">Takip bilgilerine geç</a>
<header class="ot-top"><div class="ot-wrap ot-top-inner"><a class="ot-brand" href="#"><span class="ot-brand-mark"><svg class="ot-icon ot-paw"><use href="#ot-paw"/></svg></span><span><strong>@Model.ClinicName</strong><small>Hasta sahibi takip sayfası</small></span></a><span class="ot-private"><svg class="ot-icon"><use href="#ot-shield"/></svg>Size özel</span></div></header>
<main class="ot-wrap">
<section class="ot-hero" aria-labelledby="welcome"><div><span class="ot-eyebrow">KÜÇÜK DOSTUNUZ, BÜYÜK BİR ÖZEN</span><h1 id="welcome">Dostunuzun takibi,<br><em>hep elinizin altında.</em></h1><p>Aşı tarihleri, bakım notları ve sonraki adımlar.<br class="ot-desktop-break"> Kliniğinizin paylaştığı bilgiler, sizin için bir arada.</p><span class="ot-hero-caption"><span class="ot-live-dot"></span>Kliniğinizin güncel kayıtlarından</span></div>
<aside class="ot-next"><div class="ot-next-label"><span class="ot-soft-icon"><svg class="ot-icon"><use href="#ot-calendar"/></svg></span><span>BİR SONRAKİ ADIM</span></div>@if(next != null){<strong class="ot-next-date">@next.Vaccine.Next.ToString("dd MMMM",tr)<small>@next.Vaccine.Next.Year</small></strong><p><b>@next.Patient</b> · @next.Vaccine.Name</p><span class="ot-next-foot">Sonraki uygulama tarihi · Randevu değildir</span>}else{<strong class="ot-next-empty">Her adımda<br>yanınızdayız.</strong><p>Kontrol veya randevu için aşağıdan talep bırakabilirsiniz.</p>}</aside></section>
@if(Model.Patients.Count>1){<nav class="ot-pet-nav" aria-label="Hayvan seç"><span>Dostlarınız</span>@foreach(var p in Model.Patients){<a href="#patient-@p.Id"><svg class="ot-icon ot-paw"><use href="#ot-paw"/></svg>@p.Name</a>}</nav>}
<div class="ot-layout"><div class="ot-main" id="pets">
@if(Model.Note!=null){<section class="ot-clinic-note"><span class="ot-note-icon"><svg class="ot-icon"><use href="#ot-heart"/></svg></span><div><span class="ot-eyebrow">KLİNİĞİNİZDEN BİR NOT</span><h2>Birlikte daha sağlıklı günlere</h2><p class="owner-track-text">@Model.Note</p></div></section>}
@foreach(var p in Model.Patients){<article id="patient-@p.Id" class="ot-pet-card"><header class="ot-pet-heading"><div class="ot-avatar"><svg class="ot-icon ot-paw"><use href="#ot-paw"/></svg></div><div><span class="ot-eyebrow">DOSTUNUZUN SAĞLIK TAKİBİ</span><h2>@p.Name</h2><p>@(string.IsNullOrWhiteSpace(p.Species)?"Klinik takip kaydı":p.Species)</p></div><span class="ot-pet-heart" aria-hidden="true">♡</span></header>
@if(Model.ShowVaccinations){<section class="ot-section"><div class="ot-section-heading"><h3><svg class="ot-icon"><use href="#ot-calendar"/></svg>Sonraki uygulamalar</h3><span class="ot-count">@p.Vaccines.Count(x=>x.Current)</span></div><p class="ot-section-caption">Bu tarihler uygulama planıdır; kesinleşmiş randevu değildir.</p><div class="ot-vaccines">@foreach(var v in p.Vaccines.Where(x=>x.Current).OrderBy(x=>x.Next)){var overdue=v.Next<Model.Today;var soon=!overdue && v.Next<=Model.Today.AddDays(7);<div class="ot-vaccine @(overdue?"is-overdue":"")"><div class="ot-date-tile"><strong>@v.Next.Day.ToString("00")</strong><span>@v.Next.ToString("MMM",tr)</span><small>@v.Next.Year</small></div><div class="ot-vaccine-info"><h4>@v.Name</h4><span class="ot-status @(overdue?"is-warning":soon?"is-soon":"")">@(overdue?"Tarihi geçti · Klinikle görüşün":v.Next==Model.Today?"Bugün":soon?"Bu hafta":"Planlanan uygulama")</span></div><svg class="ot-icon ot-row-icon"><use href="#ot-calendar"/></svg></div>}</div>@if(!p.Vaccines.Any(x=>x.Current)){<p class="ot-empty">Henüz paylaşılmış bir sonraki uygulama tarihi yok.</p>}</section>}
@if(Model.ShowAppointments){<section class="ot-section"><div class="ot-section-heading"><h3><svg class="ot-icon"><use href="#ot-clock"/></svg>Gelecek randevular</h3></div>@foreach(var a in p.Appointments){<div class="ot-appointment"><span class="ot-appointment-date">@a.LocalTime.ToString("dd MMMM yyyy",tr)<small>@a.LocalTime.ToString("dddd",tr)</small></span><strong>@a.LocalTime.ToString("HH:mm")</strong><span class="ot-status">Planlandı</span></div>}@if(!p.Appointments.Any()){<p class="ot-empty">Şu an planlanmış bir randevu yok. Dilerseniz aşağıdan talep bırakabilirsiniz.</p>}</section>}
@if(Model.ShowCare){@foreach(var c in p.Care){<section class="ot-section ot-care"><div class="ot-section-heading"><h3><svg class="ot-icon"><use href="#ot-heart"/></svg>Evde bakım rehberi</h3><span class="ot-status">Veteriner onaylı</span></div><div class="ot-care-step"><span>01</span><div><h4>Bugün yapılanlar</h4><p class="owner-track-text">@c.Today</p></div></div><div class="ot-care-step"><span>02</span><div><h4>Evde neler yapmalısınız?</h4><p class="owner-track-text">@c.Steps</p></div></div><div class="ot-care-call"><h4>Kliniği ne zaman aramalısınız?</h4><p class="owner-track-text">@c.Call</p></div>@if(c.FollowUp.HasValue){<p class="ot-followup-date"><svg class="ot-icon"><use href="#ot-calendar"/></svg>Kontrol: <strong>@c.FollowUp.Value.ToString("dd MMMM yyyy",tr)</strong> · Randevu için kliniğinizle görüşün.</p>}</section>}}
@if(Model.ShowHistory){<section class="ot-section"><details class="ot-history"><summary><span><svg class="ot-icon"><use href="#ot-check"/></svg>Yapılmış uygulamalar <small>(@p.Vaccines.Count)</small></span><span class="ot-chevron" aria-hidden="true">⌄</span></summary><div class="ot-timeline">@foreach(var v in p.Vaccines.OrderByDescending(x=>x.Applied)){<div class="ot-history-row"><span class="ot-timeline-dot"></span><div><h4>@v.Name</h4><time>@v.Applied.ToString("dd MMMM yyyy",tr)</time></div><span class="ot-status @(v.Current?"":"is-muted")">@(v.Current?"Uygulandı":"Yenilendi")</span></div>}@if(!p.Vaccines.Any()){<p class="ot-empty">Henüz paylaşılmış bir uygulama geçmişi yok.</p>}</div></details></section>}
<section class="ot-actions"><h3>Bir sonraki adımı birlikte planlayalım</h3><p>@p.Name için kliniğinize bir talep bırakın.</p><div class="ot-action-grid">@if(p.ContactRequested){<div class="ot-received" role="status"><svg class="ot-icon"><use href="#ot-check"/></svg><span>Aranma talebiniz kliniğe iletildi.</span></div>}else{<form method="post" action="/OwnerTrack/@ViewBag.Token/Request">@Html.AntiForgeryToken()<input type="hidden" name="patientId" value="@p.Id"><button name="kind" value="OwnerContact" class="ot-button ot-button-secondary"><svg class="ot-icon"><use href="#ot-phone"/></svg>Klinik beni arasın</button></form>}
@if(p.AppointmentRequested){<div class="ot-received" role="status"><svg class="ot-icon"><use href="#ot-check"/></svg><span>Randevu talebiniz iletildi; saat kesinleşmesi için klinik sizinle görüşecek.</span></div>}else{<form method="post" action="/OwnerTrack/@ViewBag.Token/Request">@Html.AntiForgeryToken()<input type="hidden" name="patientId" value="@p.Id"><button name="kind" value="OwnerAppointment" class="ot-button ot-button-primary">Randevu istiyorum<svg class="ot-icon"><use href="#ot-arrow"/></svg></button></form>}</div></section></article>}
</div><aside class="ot-sidebar"><section class="ot-contact-card"><span class="ot-soft-icon"><svg class="ot-icon"><use href="#ot-phone"/></svg></span><h2>Birlikte ilgileniyoruz.</h2><p>Sorularınız veya değişen bir durum için kliniğinizle iletişime geçebilirsiniz.</p>@if(!string.IsNullOrWhiteSpace(Model.Phone)){<a class="ot-clinic-phone" href="tel:@phone">@Model.Phone<svg class="ot-icon"><use href="#ot-arrow"/></svg></a>}<div class="ot-contact-footer">@Model.ClinicName</div></section><div class="ot-help-note"><svg class="ot-icon"><use href="#ot-shield"/></svg><p>Bu sayfa, kliniğinizin sizinle paylaştığı özel bir bağlantıyla açılır. Bağlantınızı başkalarıyla paylaşmayın.</p></div></aside></div>
<footer class="ot-footer"><div><svg class="ot-icon ot-paw"><use href="#ot-paw"/></svg><span>Minik dostlar, özenli takip.</span></div><p>Bu sayfa anlık mesajlaşma veya acil iletişim hattı değildir. Talepler klinik tarafından değerlendirildiğinde dönüş yapılır. Acil durumda kliniği doğrudan arayın.</p><small>@Model.ClinicName · Hasta sahibi takip sayfası</small></footer>
</main></body></html>
