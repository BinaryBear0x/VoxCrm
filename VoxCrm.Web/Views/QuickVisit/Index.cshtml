@inject VoxCrm.Web.Services.ClinicModules Modules
@model VoxCrm.Web.Models.QuickVisitModel
@using System.Text.Json
@{ViewData["Title"]="Hızlı Ziyaret";ViewData["ActiveMenu"]="quickvisit";}
<partial name="_TransferAlerts" />
<h1>Söyle, kontrol et, ziyareti tamamla</h1><p class="text-muted">Önce hastayı seçin. Anlattıklarınızı düzenleyin, ardından bütün kayıtları tek bir son kontrolde onaylayın.</p>
<form asp-action="Preview" method="post" id="visit-form"><input asp-for="SubmissionId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-4"><div class="col-lg-7"><div class="card p-4"><h2 class="h5">1. Hasta ve sahibi</h2><label asp-for="PatientId" class="form-label">Hasta</label><select asp-for="PatientId" class="form-select" id="visit-patient"><option value="">Hasta seçin</option>@foreach(var p in Model.Patients){<option value="@p.ID">@p.Name · @p.Species · @string.Join(" / ",p.Owners.Select(o=>o.PetOwner.FirstName+" "+o.PetOwner.LastName+" "+o.PetOwner.Phone))</option>}</select><label asp-for="OwnerId" class="form-label mt-3">İlgili hasta sahibi</label><select asp-for="OwnerId" class="form-select" id="visit-owner" data-selected="@Model.OwnerId"><option value="">Hasta sahibini seçin</option></select>
<h2 class="h5 mt-4">2. Anlatın veya yazın</h2><p class="small">Örnek: “4 kilo 200 gram. İç ve dış parazit uygulandı. Toplam 1500 lira. 1000 lira nakit ödendi.”</p><div class="form-check mb-2"><input type="checkbox" id="speech-consent" class="form-check-input"/><label class="form-check-label small" for="speech-consent">Mikrofonu kullanmak istiyorum. Tarayıcının konuşma hizmeti sesi harici bir hizmette işleyebilir.</label></div><div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-outline-primary" id="speech-start"><i class="bi bi-mic"></i> Anlatmaya başla</button><button type="button" class="btn btn-outline-secondary" id="speech-stop" disabled>Durdur</button></div><p id="speech-status" class="small" role="status" aria-live="polite"></p><label asp-for="Notes" class="form-label">Muayene notu</label><textarea asp-for="Notes" class="form-control" rows="6" maxlength="4000" required></textarea><button type="button" class="btn btn-outline-primary mt-2" id="visit-parse">Metindeki sayıları taslağa al</button><p class="small text-muted mt-2">Sayısal yazılmış kilo, “toplam … lira” ve “… lira ödendi” ifadeleri ayrıştırılır. Yazıyla söylenen sayılar ve tarihler tahmin edilmez. Aşıları aşağıdan kendiniz seçin; işlem yapılmadığını belirten ifadeleri kontrol edin.</p></div>
@if(await Modules.FollowUpAsync()){<div class="card p-4 mt-4"><h2 class="h5">İsteğe bağlı bakım kartı</h2><label asp-for="HomeSteps" class="form-label">Evde uygulanacak adımlar</label><textarea asp-for="HomeSteps" class="form-control" maxlength="2000" rows="3"></textarea><label asp-for="CallInstructions" class="form-label mt-2">Hangi durumda kliniği arasın?</label><textarea asp-for="CallInstructions" class="form-control" maxlength="1000"></textarea><label asp-for="FollowUpDate" class="form-label mt-2">Kontrol tarihi</label><input asp-for="FollowUpDate" type="date" class="form-control"/><small class="text-muted">Bakım kartı taslak kaydedilir. Paylaşım ve veteriner onayı mevcut bakım kartı ekranından yapılır.</small></div>} </div>
<div class="col-lg-5"><div class="card p-4"><h2 class="h5">3. İşlemleri kontrol edin</h2><label asp-for="VisitDate" class="form-label">Yapılma / ziyaret tarihi</label><input asp-for="VisitDate" type="date" class="form-control"/><label asp-for="Weight" class="form-label mt-2">Kilo (kg)</label><input asp-for="Weight" inputmode="decimal" class="form-control" placeholder="4,2"/><fieldset class="mt-3"><legend class="h6">Gerçekten yapılan uygulamalar</legend>@foreach(var type in Model.Types){<div class="form-check"><input type="checkbox" name="VaccineIds" value="@type.ID" id="vax-@type.ID" class="form-check-input" checked="@Model.VaccineIds.Contains(type.ID)"/><label class="form-check-label" for="vax-@type.ID">@type.Name <small class="text-muted">(@type.ValidityDays gün)</small></label></div>}</fieldset><hr/><label asp-for="Amount" class="form-label">Toplam ücret (₺)</label><input asp-for="Amount" inputmode="decimal" class="form-control" placeholder="1500"/><label asp-for="Paid" class="form-label mt-2">Tahsil edilen (₺)</label><input asp-for="Paid" inputmode="decimal" class="form-control" placeholder="1000"/><label asp-for="PaymentMethod" class="form-label mt-2">Ödeme yöntemi</label><select asp-for="PaymentMethod" class="form-select"><option value="">Ödeme yöntemini seçin</option><option>Nakit</option><option>Kredi Kartı</option><option>Havale/EFT</option></select><label asp-for="DueDate" class="form-label mt-2">Kalan borcun vadesi</label><input asp-for="DueDate" type="date" class="form-control"/><p class="small text-muted mt-2">Ücret boş veya sıfırsa finans kaydı açılmaz. Binlik ayırıcı kullanmayın. Tahsilat WhatsApp'a bağlanmaz.</p><button class="btn btn-primary w-100 mt-3">Son kontrol ekranını aç <i class="bi bi-arrow-right"></i></button><small class="text-muted mt-2">Bu adımda henüz hiçbir kayıt oluşturulmaz. Taslak 20 dakika geçerlidir; yeni önizleme önceki taslağı kapatır.</small></div></div></div></form>
<script id="visit-owners-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Patients.Select(p=>new{id=p.ID,owners=p.Owners.Where(o=>o.PetOwner.IsActive).Select(o=>new{id=o.PetOwnerId,label=o.PetOwner.FirstName+" "+o.PetOwner.LastName+" · "+o.PetOwner.Phone})})))</script>
@section Scripts {<script src="~/js/quick-visit.js" asp-append-version="true"></script>}
