@model VoxCrm.Application.Workday.FollowUpManager
@{ViewData["Title"]="Hasta Sahibi Takibi";ViewData["ActiveMenu"]="ownerfollowup";var input=(VoxCrm.Application.Workday.FollowUpInput)ViewBag.Input;}
<h1 class="h3">Hasta Sahibi Takibi</h1><p class="text-muted">Muayeneden bağımsız takip sayfası paylaşın; bağlantıları ve gelen talepleri buradan yönetin.</p>
<div class="card card-body mb-4"><form method="get" action="/OwnerFollowUp"><label for="followUpOwner" class="form-label">Müşteri seçin</label><div class="d-flex gap-2"><select id="followUpOwner" name="ownerId" class="form-select" required data-search-select="owner" data-required="true" data-placeholder="Ad, soyad veya telefon ara…"><option value="">Müşteri seçin</option>@foreach(var o in Model.Owners){<option value="@o.ID" selected="@(o.ID==input.OwnerId)">@o.FirstName @o.LastName — @o.Phone</option>}</select><button class="btn btn-primary">Aç</button></div></form></div>
@if(Model.Owner!=null){
<div class="card card-body mb-4"><h2 class="h5">@Model.Owner.FirstName @Model.Owner.LastName — @Model.Owner.Phone</h2><p class="small text-muted">Yalnız aşağıda seçilen hayvanlar ve bilgiler paylaşılır. İç muayene notları, borçlar ve personel notları açılmaz.</p>
<form method="post" action="/OwnerFollowUp/Issue">@Html.AntiForgeryToken()<input type="hidden" name="OwnerId" value="@input.OwnerId"><input type="hidden" name="IssueId" value="@input.IssueId"><input type="hidden" name="Revision" value="@input.Revision">
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>}
<fieldset class="mb-3"><legend class="h6">Paylaşılacak hayvanlar</legend>@foreach(var p in Model.Patients){<label class="form-check"><input class="form-check-input" type="checkbox" name="PatientIds" value="@p.ID" checked="@input.PatientIds.Contains(p.ID)"><span class="form-check-label">@p.Name — @p.Species</span></label>}@if(!Model.Patients.Any()){<p>Bu müşteriye bağlı aktif hasta yok. Önce hasta ve sahip bağlantısını kaydedin.</p>}</fieldset>
<fieldset class="mb-3"><legend class="h6">Gösterilecek bilgiler</legend>
<label class="form-check"><input type="checkbox" class="form-check-input" name="ShowVaccinations" value="true" checked="@input.ShowVaccinations">Yaklaşan aşılar / sonraki uygulama tarihleri</label><input type="hidden" name="ShowVaccinations" value="false">
<label class="form-check"><input type="checkbox" class="form-check-input" name="ShowHistory" value="true" checked="@input.ShowHistory">Yapılmış aşı ve uygulamalar</label><input type="hidden" name="ShowHistory" value="false">
<label class="form-check"><input type="checkbox" class="form-check-input" name="ShowAppointments" value="true" checked="@input.ShowAppointments">Gelecek randevuların tarih ve saati</label><input type="hidden" name="ShowAppointments" value="false">
<label class="form-check"><input type="checkbox" class="form-check-input" name="ShowCare" value="true" checked="@input.ShowCare">Geçerli ve veteriner onaylı bakım kartları</label><input type="hidden" name="ShowCare" value="false"></fieldset>
<label for="publicNote" class="form-label">Hasta sahibine not (isteğe bağlı)</label><textarea id="publicNote" name="PublicNote" class="form-control mb-3" rows="3" maxlength="2000">@input.PublicNote</textarea>
<label for="shareDays" class="form-label">Bağlantı kaç gün açık kalsın?</label><input id="shareDays" name="Days" type="number" min="1" max="30" value="@input.Days" class="form-control mb-3" required>
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="ConfirmRecipient" value="true" required checked="@input.ConfirmRecipient">Müşteriyi, sahiplik bağlantısını ve paylaşılacak bilgileri kontrol ettim.</label>
<button class="btn btn-primary" disabled="@(!Model.Patients.Any())">@(Model.Share==null?"Takip bağlantısı oluştur":"Yeni bağlantı oluştur ve eskisini kapat")</button></form></div>}
<h2 class="h5">Bağlantı yönetimi</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Müşteri</th><th>Durum</th><th>Geçerlilik</th><th>İşlem</th></tr></thead><tbody>@foreach(var s in Model.Shares){var owner=Model.Owners.SingleOrDefault(x=>x.ID==s.PetOwnerId);<tr><td>@(owner==null?"Pasif müşteri":owner.FirstName+" "+owner.LastName+" — "+owner.Phone)</td><td>@(!s.IsActive || s.TokenHash==null?"Kapalı":s.ExpiresAt.ToUniversalTime()<=DateTime.UtcNow?"Süresi doldu":"Açık — alıcı kontrolü açılışta yapılır")</td><td>@s.ExpiresAt.ToString("dd.MM.yyyy")</td><td><a href="/OwnerFollowUp?ownerId=@s.PetOwnerId" class="btn btn-sm btn-outline-primary">Ayarlar / Yenile</a>@if(s.IsActive && s.TokenHash!=null){<form method="post" action="/OwnerFollowUp/Revoke" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@s.ID"><input type="hidden" name="revision" value="@s.Revision"><button class="btn btn-sm btn-outline-danger">Bağlantıyı kapat</button></form>}</td></tr>}@if(!Model.Shares.Any()){<tr><td colspan="4">Henüz takip bağlantısı oluşturulmadı.</td></tr>}</tbody></table></div>
<h2 class="h5 mt-4">Takip gerektiren talepler</h2><p class="small text-muted">Talepler görev listesinde ve ana sayfadaki geri arama alanında da görünür. Randevu talebi otomatik randevu oluşturmaz.</p>@foreach(var task in Model.Requests){<div class="card card-body mb-2 d-flex flex-row justify-content-between gap-3"><span>@task.Title</span><a href="/Workday/Task/@task.ID" class="btn btn-sm btn-outline-primary">Talebi yönet</a></div>}@if(!Model.Requests.Any()){<p class="text-muted">Bekleyen talep yok.</p>}
