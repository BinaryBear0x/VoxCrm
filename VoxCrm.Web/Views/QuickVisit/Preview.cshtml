@model VoxCrm.Web.Models.QuickVisitPreview
@{ViewData["Title"]="Ziyaret son kontrol";ViewData["ActiveMenu"]="quickvisit";}
<partial name="_TransferAlerts" />
<h1>Son kontrol</h1><p>Henüz kayıt yapılmadı. Onayladığınızda muayene, seçili uygulamalar ve finans hareketleri birlikte kaydedilir.</p><div class="row g-4"><div class="col-lg-7"><div class="card p-4"><h2 class="h4">@Model.Patient</h2><p>@Model.Owner · @Model.Phone</p><p><strong>Tarih:</strong> @Model.Model.VisitDate.ToString("dd.MM.yyyy") · <strong>Kilo:</strong> @(Model.Weight?.ToString()+" kg")</p><h3 class="h6">Muayene notu</h3><p style="white-space:pre-wrap">@Model.Model.Notes</p><h3 class="h6">Yapılan uygulamalar</h3>@if(Model.Vaccines.Count==0){<p>Uygulama seçilmedi.</p>}else{<ul>@foreach(var name in Model.Vaccines){<li>@name</li>}</ul><p class="small text-muted">Sonraki tarih, uygulama türünün geçerlilik süresine göre hesaplanır. Eski uygulamalar mevcut yenileme akışıyla korunur. Otomatik aşı hatırlatmaları kliniğin mevcut ayarlarına bağlıdır.</p>}@if(!string.IsNullOrWhiteSpace(Model.Model.HomeSteps)){<h3 class="h6">Bakım kartı — taslak</h3><p style="white-space:pre-wrap">@Model.Model.HomeSteps</p><p>@Model.Model.CallInstructions</p><p>Kontrol: @Model.Model.FollowUpDate?.ToString("dd.MM.yyyy")</p>}</div></div><div class="col-lg-5"><div class="card p-4"><h2 class="h5">Ödeme özeti</h2><p>Toplam: <strong>@Model.Amount.ToString("N2") ₺</strong></p><p>Tahsil edilen: @Model.Paid.ToString("N2") ₺ · @Model.Model.PaymentMethod</p><p>Kalan: <strong>@((Model.Amount-Model.Paid).ToString("N2")) ₺</strong></p><p>Vade: @Model.Model.DueDate.ToString("dd.MM.yyyy")</p><form asp-action="Commit" method="post"><input type="hidden" name="token" value="@Model.Model.SubmissionId"/><div class="form-check my-3"><input type="checkbox" name="confirmed" value="true" id="confirm-visit" class="form-check-input" required/><label class="form-check-label" for="confirm-visit">Hasta, sahibi, işlemler, tarihler ve tutarlar doğru; kaydedilsin.</label></div><button class="btn btn-primary w-100">Onayla ve ziyareti kaydet</button></form><a class="btn btn-outline-secondary mt-2" asp-action="Edit" asp-route-token="@Model.Model.SubmissionId">Düzenlemeye dön</a></div></div></div>
