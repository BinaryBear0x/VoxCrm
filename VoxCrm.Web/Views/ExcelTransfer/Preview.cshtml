@model VoxCrm.Web.Services.TransferStage
@{ ViewData["Title"]="Aktarım önizleme"; ViewData["ActiveMenu"]="excel"; }
<partial name="_TransferAlerts" />
<h1>Kontrol edin, sonra aktarın</h1><p>Henüz kayıt yapılmadı. Her satırı kendiniz seçin. Hatalı ve mükerrer satırlar aktarılamaz.</p>
<form asp-action="Confirm" method="post"><input type="hidden" name="token" value="@ViewBag.Token"/><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Seç</th><th>Satır</th><th>Hasta</th><th>Sahip / telefon</th><th>Kontrol sonucu</th></tr></thead><tbody>@foreach(var x in Model.Checks!){<tr class="@(x.Blocked?"table-danger":"")"><td><input class="form-check-input" type="checkbox" name="selected" value="@x.Row.Number" disabled="@x.Blocked" aria-label="@x.Row.Number numaralı satırı aktar"/></td><td>@x.Row.Number</td><td>@x.Row.Patient <small class="d-block text-muted">@x.Row.Species · @x.Row.Breed · @x.Row.Chip · @x.Row.Birth</small></td><td>@x.Row.FirstName @x.Row.LastName <span class="d-block">@x.Row.Phone</span></td><td>@x.Message</td></tr>}</tbody></table></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" asp-action="Map" asp-route-token="@ViewBag.Token">Eşleştirmeye dön</a><button class="btn btn-primary">Seçili satırları onayla ve aktar</button></div></form>
