@inject VoxCrm.Web.Services.ClinicModules Modules
@model VoxCrm.Application.Workday.CareEditor
@{ ViewData["Title"] = "Bakım kartı ve hesap kontrolü"; ViewData["ActiveMenu"] = "workday"; var e = Model.Examination; var c = Model.Card; }
<div class="my-4"><a href="/Muayene/Details/@e.ID">← Muayene detayı</a><h1 class="h3 mt-2">@e.Patient.Name — bakım kartı</h1><p class="text-muted">Alıcı: @(Model.Recipient == null ? "Aktif birincil sahip yok" : Model.Recipient.FirstName + " " + Model.Recipient.LastName + " — " + Model.Recipient.Phone)</p></div>
@foreach (var kind in new[] { "Error", "Success" }) { if (TempData[kind] is string message) { <div class="alert alert-@(kind == "Error" ? "danger" : "success")" role="alert">@message</div> } }
@if(await Modules.FollowUpAsync()){
<div class="alert alert-info">Hasta sahibine yalnız aşağıdaki onaylanmış içerik gösterilir. İç muayene notları, tahsilat bilgileri ve personel bilgileri paylaşılmaz. Otomatik mesaj gönderilmez.</div>
<form method="post" action="/Workday/SaveCare" class="card card-body shadow-sm mb-4">@Html.AntiForgeryToken()<input type="hidden" name="ExaminationId" value="@e.ID"><input type="hidden" name="Revision" value="@(c?.Revision ?? 0)">
<h2 class="h5">Bakım kartı taslağı <span class="badge bg-secondary">@(c?.State == "Published" ? "Onaylı / paylaşılabilir" : c?.State == "Revoked" ? "Bağlantısı kapalı" : "Taslak")</span></h2>
<div class="mb-3"><label for="actions" class="form-label">Bugün yapılanlar</label><textarea id="actions" name="TodayActions" rows="3" class="form-control" maxlength="4000" required>@c?.TodayActions</textarea></div>
<div class="mb-3"><label for="steps" class="form-label">Evde uygulanacak adımlar</label><textarea id="steps" name="HomeSteps" rows="5" class="form-control" maxlength="8000" required>@c?.HomeSteps</textarea></div>
<div class="mb-3"><label for="followup" class="form-label">Kontrol tarihi (isteğe bağlı)</label><input id="followup" name="FollowUpDate" type="date" value="@c?.FollowUpDate?.ToString("yyyy-MM-dd")" class="form-control"></div>
<div class="mb-3"><label for="call" class="form-label">Hangi durumda kliniği aramalı?</label><textarea id="call" name="CallInstructions" rows="3" class="form-control" maxlength="4000" required>@c?.CallInstructions</textarea></div>
<div><button class="btn btn-primary">Taslağı kaydet</button></div><p class="small text-muted mt-2 mb-0">Onaylanmış kartı düzenleyip kaydetmek eski paylaşım bağlantısını kapatır. Yeniden veteriner onayı gerekir.</p></form>
@if (c != null) {
<div class="card card-body shadow-sm mb-4"><h2 class="h5">Veteriner onayı ve paylaşım</h2>
@if (Model.CanApprove) { <form method="post" action="/Workday/PublishCare">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.ID"><input type="hidden" name="revision" value="@c.Revision"><div class="form-check mb-3"><input id="vet" name="veterinarianConfirmed" value="true" type="checkbox" class="form-check-input" required><label for="vet" class="form-check-label">Veteriner olarak kaydedilmiş içeriği ve alıcıyı kontrol ettim, paylaşılmasını onaylıyorum.</label></div><button class="btn btn-success">Onayla ve 14 günlük bağlantı oluştur</button></form> }
else { <p class="text-muted">Taslağı kaydedebilirsiniz. Paylaşım için bayi panelinden bu hesaba veteriner bakım kartı onay yetkisi verilmelidir.</p> }
@if (c.State == "Published") { <p class="small mt-3">Onay: @c.ApprovedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · Son geçerlilik: @c.ExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p><form method="post" action="/Workday/RevokeCare" data-confirm="Bu paylaşım bağlantısı kapatılsın mı?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.ID"><input type="hidden" name="revision" value="@c.Revision"><button class="btn btn-outline-danger btn-sm">Paylaşım bağlantısını kapat</button></form> }
@if (c.OwnerResponse != null) { <p class="mt-3 mb-0">Hasta sahibi yanıtı: <strong>@(c.OwnerResponse == "Applied" ? "Uyguladım" : "Klinikle görüşmek istiyorum")</strong> · @c.RespondedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p> }
</div> }
}
<div class="card card-body shadow-sm mb-4"><h2 class="h5">Muayene hesabını kontrol et</h2><p class="text-muted">Bu işlem borç/ödeme eklemez. Mevcut hesabı bu muayeneyle ilişkilendirir veya ücretsiz/kapsam içi kontrol notu kaydeder.</p>
@if (e.BillingReviewedAt.HasValue) { <div class="alert alert-success">Hesap kontrolü yapıldı: @e.BillingReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<div>@e.BillingReviewNote</div></div> }
<form method="post" action="/Workday/ReviewBilling">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.ID"><label for="account" class="form-label">Mevcut tahsilat hesabı</label><select id="account" name="accountId" class="form-select mb-3"><option value="">Ücretsiz / kapsam içi — gerekçe yazılmalı</option>@foreach (var a in Model.FinanceAccounts) { <option value="@a.Id" selected="@(a.Id == e.ReviewedFinanceAccountId)">@a.Label</option> }</select><label for="reason" class="form-label">Kontrol açıklaması</label><input id="reason" name="reason" class="form-control mb-3" maxlength="500" required><button class="btn btn-outline-primary">Hesap kontrolünü kaydet</button> <a href="/Finance" class="btn btn-link">Tahsilat ekranı</a></form></div>
