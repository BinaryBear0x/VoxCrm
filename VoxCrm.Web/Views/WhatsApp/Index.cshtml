@model VoxCrm.Web.Models.WhatsAppSettingsViewModel
@using VoxCrm.Web.Services
@using VoxCrm.Application.WhatsApp
@{ ViewData["Title"] = "WhatsApp"; ViewData["ActiveMenu"] = "whatsapp";
    var connected = Model.SessionStatus?.Status == "ready";
    var sessionStatus = Model.SessionStatus?.Status ?? Model.Qr?.Status ?? "offline";
    var poll = TempData["WhatsAppConnectStarted"] != null || sessionStatus is "connecting" or "qr";
}
<div class="d-flex justify-content-between align-items-center my-4 flex-wrap gap-2">
    <div><h1 class="h3">WhatsApp</h1><span class="text-muted">@Model.Clinic.Name</span></div>
    @if (Model.IsDealer) {
        <form method="get"><select name="clinicId" class="form-select" data-submit-on-change>
        @foreach (var c in Model.AvailableClinics) { <option value="@c.ID" selected="@(c.ID == Model.Clinic.ID)">@c.Name</option> }
        </select></form>
    }
</div>
@foreach (var notice in new[] { "Error", "Warning" }) {
    if (TempData[notice] is string message) { <div class="alert alert-@(notice == "Error" ? "danger" : notice == "Warning" ? "warning" : notice == "Success" ? "success" : "info")" role="alert">@message</div> }
}
@if (Model.GatewayWarning != null) { <div class="alert alert-danger" role="alert">WhatsApp servisine erişilemiyor. Hiçbir bağlantı doğrulanamadı. Yerel servis çalışmıyorsa mesajlar gönderilmeden kuyrukta bekler.</div> }
@if (!Model.Clinic.IsWhatsAppEnabled) { <div class="alert alert-warning">WhatsApp gönderimi kapalı. Bağlantı kurmak tek başına gönderimi açmaz; aşağıdaki ayarlardan ayrıca etkinleştirin.</div> }
@if (Model.Notifications.Any(x => x.Status == "NeedsReview")) { <div class="alert alert-danger" role="alert">İncelenmesi gereken mesajlar var (kuyrukta "İnceleme gerekiyor" durumunda). Her birinde <strong>Gözden geçir</strong> ile nedenini görün: alıcı bilgisi düzelmişse kontrol edip yeniden sıraya alabilir, gerekmiyorsa iptal edebilirsiniz. Teslim sonucu belirsizse önce WhatsApp telefonunda sohbeti kontrol edin.</div> }
<div class="row g-4">
<div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body">
    <h2 class="h5">Bağlantı</h2><span class="badge bg-@(connected ? "success" : "warning text-dark")" data-wa-status-badge>@WhatsAppUi.Status(sessionStatus)</span>
    <dl class="row mt-3"><dt class="col-5">Bağlı numara</dt><dd class="col-7" data-wa-phone>@(string.IsNullOrEmpty(Model.SessionStatus?.ConnectedPhone) ? "Bağlı numara yok" : WhatsAppUi.ConnectedPhone(Model.SessionStatus.ConnectedPhone))</dd>
    <dt class="col-5">Son görülme</dt><dd class="col-7">@(Model.SessionStatus?.LastSeenAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</dd>
    <dt class="col-5">Kopma / hata nedeni</dt><dd class="col-7" data-wa-last-error>@(string.IsNullOrWhiteSpace(Model.SessionStatus?.LastError) ? "Bildirilmiş hata yok" : WhatsAppUi.Error(Model.SessionStatus.LastError))</dd></dl>
    <form method="post" action="/WhatsApp/Connect" class="d-inline" data-wa-connect-form>@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID"><button class="btn btn-primary" data-wa-connect-button><span data-wa-connect-text>QR ile bağla / yeniden bağla</span></button></form>
    <form method="post" action="/WhatsApp/Disconnect" class="d-inline" data-confirm="WhatsApp bağlantısını kesmek istiyor musunuz?">@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID"><button class="btn btn-outline-danger">Bağlantıyı kes</button></form>
    <div class="mt-3 @(poll || Model.Qr?.Qr != null ? "" : "d-none")" data-wa-qr-panel data-wa-auto-poll="@(poll ? "true" : "false")" data-wa-qr-url="/WhatsApp/QrStatus?clinicId=@Model.Clinic.ID">
        <div data-wa-qr-loading>Bağlantı durumu kontrol ediliyor…</div><img data-wa-qr-image src="@Model.Qr?.Qr" alt="WhatsApp bağlantı QR kodu" class="img-fluid @(Model.Qr?.Qr == null ? "d-none" : "")" style="max-width:280px">
        <p data-wa-qr-status>Telefonunuzda WhatsApp → Bağlı cihazlar → Cihaz bağla yolundan okutun.</p><div data-wa-qr-error class="alert alert-danger d-none" role="alert"></div>
    </div>
</div></div></div>
<div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body">
    <h2 class="h5">Gönderim izinleri</h2>
    <form method="post" action="/WhatsApp/SaveSendingSettings">@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID">
    @if (Model.IsDealer) {
    <div class="form-check mb-3"><input id="enabled" class="form-check-input" type="checkbox" name="enabled" value="true" checked="@Model.Clinic.IsWhatsAppEnabled"><label class="form-check-label" for="enabled">WhatsApp gönderimini etkinleştir (bayi izni)</label></div>
    }
    <div class="form-check mb-3"><input id="automatic" class="form-check-input" type="checkbox" name="automatic" value="true" checked="@Model.Clinic.AutomaticVaccinationRemindersEnabled"><label class="form-check-label" for="automatic">Otomatik aşı hatırlatmalarını etkinleştir</label></div>
    <div class="form-check mb-3"><input id="manual" class="form-check-input" type="checkbox" name="manual" value="true" checked="@Model.Clinic.ManualWhatsAppEnabled"><label class="form-check-label" for="manual">Önizleme ve onay ile manuel gönderime izin ver</label></div>
    <p class="small text-muted">Otomatik aşı hatırlatmaları varsayılan olarak kapalıdır. Kapatılan türün bekleyen mesajları iptal edilir. Tahsilat işlemleri WhatsApp mesajı oluşturmaz.</p><button class="btn btn-primary">Ayarları kaydet</button></form>
    <p class="small text-muted mt-3 mb-0">Gönderim saatleri: @(Model.Clinic.WhatsAppSendWindowEnabled ? $"{Model.Clinic.WhatsAppSendWindowStart}–{Model.Clinic.WhatsAppSendWindowEnd} ({Model.Clinic.WhatsAppTimeZoneId})" : "24 saat"). Sıradaki izin: @Model.NextAllowedSendAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
</div></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-body">
    @{ var forecast = Model.ReminderPreview; var goingNow = forecast?.Items.Count(i => i.GoesNow) ?? 0; }
    <h2 class="h5">Otomatik hatırlatma özeti <span class="text-muted fs-6">(önümüzdeki 30 gün)</span></h2>
    @if (Model.Clinic.AutomaticVaccinationRemindersEnabled) {
        <p class="mb-2"><span class="badge bg-success">Otomatik hatırlatma açık</span> Aşağıdaki mesajlar ek onay gerekmeden günlük çalışmada sıraya alınır ve gönderim saatlerinde gider. Göndermek istemediklerinizi kuyruktan iptal edebilir, metni aşağıdaki şablondan değiştirebilirsiniz.</p>
    } else {
        <p class="mb-2"><span class="badge bg-secondary">Otomatik hatırlatma kapalı</span> Gönderim izinlerinden açarsanız aşağıdaki mesajlar ek onay gerekmeden sıraya alınır. Açmadan önce metni ve alıcıları buradan kontrol edebilirsiniz.</p>
    }
    @if (forecast == null || forecast.TotalEligible == 0) {
        <p class="text-muted mb-0">Önümüzdeki 30 günde otomatik gidecek hatırlatma yok.@(forecast != null && forecast.AlreadyQueued > 0 ? $" ({forecast.AlreadyQueued} aşı için mesaj zaten kuyrukta veya işlenmiş.)" : "")</p>
    } else {
        <p class="mb-2"><strong>@forecast.TotalEligible</strong> müşteriye hatırlatma gidecek; <strong>@goingNow</strong> tanesi hatırlatma günü gelmiş olduğu için bir sonraki günlük çalışmada sıraya girer.</p>
        @if (forecast.SkippedNoConsent + forecast.SkippedNoPhone + forecast.SkippedNoPrimaryOwner + forecast.AlreadyQueued > 0) {
            <ul class="small text-muted">
                @if (forecast.SkippedNoConsent > 0) { <li>@forecast.SkippedNoConsent aşı için müşterinin WhatsApp izni yok, <strong>gitmeyecek</strong>.</li> }
                @if (forecast.SkippedNoPhone > 0) { <li>@forecast.SkippedNoPhone aşı için müşterinin telefonu yok, <strong>gitmeyecek</strong>.</li> }
                @if (forecast.SkippedNoPrimaryOwner > 0) { <li>@forecast.SkippedNoPrimaryOwner aşı için aktif birincil sahip yok, <strong>gitmeyecek</strong>.</li> }
                @if (forecast.AlreadyQueued > 0) { <li>@forecast.AlreadyQueued aşı için mesaj zaten kuyrukta veya işlenmiş.</li> }
            </ul>
        }
        <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Gideceği gün</th><th>Müşteri / hayvan</th><th>Aşı (vade)</th><th>Mesaj</th></tr></thead><tbody>
        @foreach (var item in forecast.Items.Take(15)) {
            <tr><td>@(item.GoesNow ? "Sıradaki çalışmada" : item.PlannedDate.ToString("dd.MM.yyyy"))</td><td>@item.OwnerName<div class="small text-muted">@item.PatientName</div></td>
            <td>@item.VaccineName <span class="text-muted">(@item.DueDate.ToString("dd.MM.yyyy"))</span></td>
            <td><details><summary class="small">Metni göster</summary><div class="small border rounded p-2 mt-1" style="white-space:pre-wrap">@item.Message</div></details></td></tr>
        }
        </tbody></table></div>
        @if (forecast.TotalEligible > 15) { <p class="small text-muted mb-0">İlk 15 kayıt gösteriliyor; toplam @forecast.TotalEligible.</p> }
    }
</div></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">Aşı hatırlatma şablonu</h2>
    @{ var unknownFields = VaccinationMessageTemplate.UnknownPlaceholders(Model.TemplateBody); }
    @if (unknownFields.Count > 0) {
        <div class="alert alert-warning" role="alert">Kayıtlı şablonda tanınmayan alanlar var; müşteriye <strong>olduğu gibi</strong> gidecek: @string.Join(", ", unknownFields.Select(name => "{" + name + "}")). Düzeltip kaydedin.</div>
    }
    <p class="small text-muted">Otomatik ve aşı kaydından hazırlanan mesajlar bu metinle oluşturulur. Kullanılabilir alanlar:
    @foreach (var placeholder in VaccinationMessageTemplate.Placeholders) { <code class="me-1">@("{" + placeholder + "}")</code> }
    Alan boşsa (ör. soyad yok) fazladan boşluk bırakılmaz. Kaydedince bekleyen hatırlatmaların metni günlük çalışmada yenilenir; gönderilmiş mesajlar değişmez.</p>
    <form method="post" action="/WhatsApp/SaveTemplate">@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID">
        <textarea id="templateBody" name="body" class="form-control mb-2" rows="5" maxlength="1000" required>@Model.TemplateBody</textarea>
        <div class="border rounded p-2 mb-3 bg-light"><div class="small text-muted">Örnek (kayıtlı şablonla):</div><div style="white-space:pre-wrap">@Model.TemplateSample</div></div>
        <button class="btn btn-primary">Şablonu kaydet</button>
        <button type="button" class="btn btn-outline-secondary" data-wa-load-default="@VaccinationMessageTemplate.DefaultBody" data-wa-target="#templateBody">Varsayılan metni yükle</button>
    </form>
</div></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">Manuel mesaj hazırla</h2>
    <form method="post" action="/WhatsApp/SendManual" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID">
    <div class="col-md-6"><label for="recipient" class="form-label">Müşteri — ad, soyad ve telefon</label><select id="recipient" name="ownerId" class="form-select" required><option value="">Müşteri seçin</option>
        @foreach (var o in Model.Owners) { <option value="@o.ID">@o.FirstName @o.LastName — @o.Phone @(o.WhatsAppConsent ? "" : "(WhatsApp izni yok)")</option> }
    </select></div>
    <div class="col-md-6"><label for="patient" class="form-label">İlgili hayvan (varsa)</label><select id="patient" name="patientId" class="form-select"><option value="">Hayvan seçilmedi</option>
        @foreach (var o in Model.Owners) { foreach (var link in o.OwnedPatients.Where(x => x.IsActive && x.Patient.IsActive)) { <option value="@link.PatientId" data-owner="@o.ID">@link.Patient.Name — @o.FirstName @o.LastName — @o.Phone</option> } }
    </select></div>
    <div class="col-12"><label for="manualMessageText" class="form-label">Mesaj</label><textarea id="manualMessageText" name="message" class="form-control" rows="3" maxlength="4000" required></textarea></div>
    <div class="col-12"><button class="btn btn-success">Alıcı ve mesajı önizle</button></div></form>
</div></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">Mesaj kuyruğu</h2><p class="text-muted small">Son 100 mesaj. Önizleme, iptal ve güvenli yeniden deneme bu alandan yönetilir.</p>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Alıcı / hayvan</th><th>Tür</th><th>Durum</th><th>Sebep / sonraki deneme</th><th>İşlem</th></tr></thead><tbody>
    @foreach (var n in Model.Notifications) {
        var petName = n.VaccinationRecord?.Patient?.Name ?? Model.Owners.SelectMany(o => o.OwnedPatients).FirstOrDefault(x => x.PatientId == n.PatientId)?.Patient.Name;
        <tr><td><strong>@n.PetOwner.FirstName @n.PetOwner.LastName</strong><div>@n.PhoneNumber</div><div class="small text-muted">@(petName ?? "Hayvan belirtilmedi")</div></td>
        <td>@(n.IsAutomatic ? "Otomatik aşı" : n.VaccinationRecordId.HasValue ? "Manuel aşı" : "Manuel mesaj")</td>
        <td><span class="badge bg-@(n.Status == "Sent" ? "success" : n.Status is "Failed" or "NeedsReview" ? "danger" : "secondary")">@WhatsAppUi.Status(n.Status, connected)</span><div class="small">Deneme: @n.RetryCount</div></td>
        <td class="small">@(n.LastError != null ? WhatsAppUi.Error(n.LastError) : n.Status == "Pending" && !connected ? "Bağlantı kurulunca, izin verilen saatte işlenecek." : "—")<div>@(n.NextAttemptAt.HasValue ? "Sonraki deneme: " + n.NextAttemptAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Planlı deneme yok")</div></td>
        <td><a class="btn btn-outline-primary btn-sm" href="/WhatsApp/Preview?clinicId=@Model.Clinic.ID&amp;id=@n.ID">@(n.Status == "NeedsReview" ? "Gözden geçir" : "Önizle")</a>
        @if (n.Status is "Pending" or "RetryScheduled" or "NeedsReview") { <form method="post" action="/WhatsApp/ManageNotification" class="d-inline" data-confirm="Bu bekleyen mesaj iptal edilsin mi?">@Html.AntiForgeryToken()<input type="hidden" name="clinicId" value="@Model.Clinic.ID"><input type="hidden" name="id" value="@n.ID"><input type="hidden" name="operation" value="cancel"><button class="btn btn-outline-danger btn-sm">İptal</button></form> }
        </td></tr>
    }
    @if (!Model.Notifications.Any()) { <tr><td colspan="5" class="text-muted text-center">Kuyrukta mesaj yok.</td></tr> }
    </tbody></table></div>
</div></div></div>
</div>
@section Scripts { <script src="~/js/app-toast.js" asp-append-version="true"></script><script src="~/js/whatsapp.js" asp-append-version="true"></script> }
