@model VoxCrm.Web.Models.ClinicUserAccessViewModel
@{ ViewData["Title"] = "Kullanıcı erişim yönetimi"; ViewData["ActiveMenu"] = "dealer"; }
<div class="my-4"><a href="/Dealer/Users/@Model.Clinic.ClinicId">@Model.Clinic.ClinicName — Kullanıcılar</a><h1 class="h3 mt-2">@Model.User.FirstName @Model.User.LastName</h1><p class="text-muted">@Model.User.Email</p></div>
@if (TempData["AccessError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<div class="alert alert-info">Her işlem kullanıcının mevcut oturumlarını kapatır ve gerekçesiyle loglanır. Geçici parola kullanıcıya ayrıca iletilmelidir; ilk girişte değiştirmesi zorunludur.</div>
<div class="row g-4">
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body">
        <h2 class="h5">Kullanıcı bilgileri</h2>
        <p class="text-muted">Giriş adresini değiştirmek klinik iletişim e-postasını değiştirmez.</p>
        <form method="post" action="/Dealer/ManageUser/@Model.Clinic.ClinicId?userId=@Model.User.Id">
            @Html.AntiForgeryToken()<input type="hidden" name="Operation" value="UpdateProfile">
            <div class="mb-3"><label class="form-label" for="firstName">Ad</label><input id="firstName" name="FirstName" class="form-control" value="@Model.User.FirstName" maxlength="100" required></div>
            <div class="mb-3"><label class="form-label" for="lastName">Soyad</label><input id="lastName" name="LastName" class="form-control" value="@Model.User.LastName" maxlength="100" required></div>
            <div class="mb-3"><label class="form-label" for="email">Giriş e-postası</label><input id="email" name="Email" type="email" class="form-control" value="@Model.User.Email" maxlength="254" required></div>
            <div class="mb-3"><label class="form-label" for="profileReason">İşlem gerekçesi</label><input id="profileReason" name="Reason" class="form-control" maxlength="500" required></div>
            <div class="mb-3"><label class="form-label" for="profilePassword">Bayi parolanız</label><input id="profilePassword" name="DealerPassword" type="password" class="form-control" maxlength="128" required autocomplete="current-password"></div>
            <button class="btn btn-primary">Bilgileri güncelle</button>
        </form>
    </div></div></div>
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body">
        <h2 class="h5">Güvenlik işlemi</h2>
        <p>Hesap: <strong>@(Model.User.LoginDisabled ? "Askıda" : Model.User.LockedOut ? "Kilitli" : "Açık")</strong> · MFA: <strong>@(Model.User.TwoFactorEnabled ? "Açık" : "Kapalı")</strong></p>
        <form method="post" action="/Dealer/ManageUser/@Model.Clinic.ClinicId?userId=@Model.User.Id" data-confirm="Bu kullanıcı için seçtiğiniz güvenlik işlemini uygulamak istiyor musunuz?">
            @Html.AntiForgeryToken()
            <div class="mb-3"><label class="form-label" for="operation">İşlem</label><select id="operation" name="Operation" class="form-select" required>
                <option value="">İşlem seçin</option>
                @if (Model.Clinic.ClinicActive && !Model.User.LoginDisabled) {
                    <option value="TemporaryPassword">Geçici parola belirle (ilk girişte değişir)</option>
                    <option value="Unlock">Hatalı giriş kilidini aç</option>
                    @if (!Model.User.HasPassword) { <option value="RenewActivation">Aktivasyon bağlantısını yenile</option> }
                }
                @if (!Model.User.LoginDisabled) { <option value="Suspend">Hesabı askıya al</option> }
                else if (Model.Clinic.ClinicActive) { <option value="Enable">Askıdaki hesabı yeniden aç</option> }
                <option value="RevokeSessions">Tüm oturumları kapat</option>
                @if (Model.User.CanApproveCareCards) { <option value="RevokeCareApproval">Veteriner bakım kartı onay yetkisini kaldır</option> }
                else if (Model.Clinic.ClinicActive) { <option value="GrantCareApproval">Veteriner bakım kartı onay yetkisi ver</option> }
                @if (Model.User.TwoFactorEnabled) { <option value="ResetMfa">MFA ve kurtarma kodlarını sıfırla</option> }
            </select></div>
            <div class="mb-3"><label class="form-label" for="newPassword">Yeni geçici parola (yalnız parola belirlerken)</label><input id="newPassword" name="NewPassword" type="password" class="form-control" minlength="12" maxlength="128" autocomplete="new-password"><div class="form-text">12–128 karakter; büyük/küçük harf, rakam ve özel karakter kullanın.</div></div>
            <div class="mb-3"><label class="form-label" for="securityReason">İşlem gerekçesi</label><input id="securityReason" name="Reason" class="form-control" maxlength="500" required></div>
            <div class="mb-3"><label class="form-label" for="securityPassword">Bayi parolanız</label><input id="securityPassword" name="DealerPassword" type="password" class="form-control" maxlength="128" required autocomplete="current-password"></div>
            <button class="btn btn-danger">Seçili işlemi uygula</button>
        </form>
    </div></div></div>
</div>
<div class="mt-4"><a class="btn btn-outline-secondary" href="/Dealer/Logs?clinicId=@Model.Clinic.ClinicId&amp;category=ClinicAccess">Bu kliniğin hesap işlem logları</a></div>
