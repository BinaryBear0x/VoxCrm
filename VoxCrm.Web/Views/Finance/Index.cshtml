@model VoxCrm.Application.Finance.FinanceIndexModel
@{ ViewData["Title"] = "Borç ve Tahsilat"; ViewData["ActiveMenu"] = "finance"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3">Borç ve Tahsilat</h1><p class="text-muted mb-0">Borçları, taksitleri ve yapılan ödemeleri takip edin.</p></div><a asp-action="Create" class="btn btn-primary">Yeni borç kaydı</a></div>
<partial name="_Messages" />
<div class="row g-3 mb-4">
@foreach (var item in new[] { ("Kalan alacak", Model.TotalOutstanding, "text-danger"), ("Toplam tahsilat", Model.TotalCollected, "text-success"), ("Vadesi geçen", Model.TotalOverdue, "text-warning") }) {
<div class="col-md-4"><div class="card card-body"><span class="text-muted">@item.Item1</span><strong class="fs-4 @item.Item3">@item.Item2.ToString("N2") TL</strong></div></div>
}
</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="İsim veya açıklama ara" aria-label="İsim veya açıklama ara" /></div><div class="col-md-3"><select name="status" class="form-select" aria-label="Durum"><option value="">Tüm durumlar</option><option value="open" selected="@(Model.Status == "open")">Borcu kalanlar</option><option value="paid" selected="@(Model.Status == "paid")">Ödenenler</option><option value="overdue" selected="@(Model.Status == "overdue")">Vadesi geçenler</option></select></div><div class="col-md-2 d-flex align-items-center"><label><input type="checkbox" name="showDeleted" value="true" checked="@Model.ShowDeleted" /> Silinenler dahil</label></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrele</button></div></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>İsim / Açıklama</th><th>Toplam borç</th><th>Ödenen</th><th>Kalan</th><th>Durum</th><th></th></tr></thead><tbody>
@foreach (var a in Model.Accounts) {
<tr><td><strong>@a.CustomerName</strong><div class="small text-muted">@a.Description</div></td><td>@a.Total.ToString("N2") TL</td><td>@a.Paid.ToString("N2") TL</td><td>@a.Remaining.ToString("N2") TL</td><td>@if (!a.IsActive) { <span class="badge bg-secondary">Silindi</span> } else if (a.Total == 0) { <span class="badge bg-secondary">Borç yok</span> } else if (a.Remaining == 0) { <span class="badge bg-success">Ödendi</span> } else if (a.Overdue > 0) { <span class="badge bg-danger">Vadesi geçti</span> } else { <span class="badge bg-warning text-dark">@(a.Paid > 0 ? "Kısmen ödendi" : "Bekliyor")</span> }</td><td><a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Aç</a></td></tr>
}
@if (!Model.Accounts.Any()) { <tr><td colspan="6" class="text-center text-muted p-5">Kayıt bulunamadı.</td></tr> }
</tbody></table></div></div>
