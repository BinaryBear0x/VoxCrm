@inject VoxCrm.Web.Services.ClinicModules Modules
@{ var active = ViewData["ActiveMenu"]?.ToString(); var profile = User.Identity?.Name ?? "Kullanıcı"; }
<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] · VoxCRM</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"><link rel="stylesheet" href="~/css/crm.css" asp-append-version="true"></head>
<body class="crm-shell">@await Html.PartialAsync("_ToastNotifications")
<header class="navbar navbar-top sticky-top flex-nowrap crm-topbar">
<a class="navbar-brand crm-brand" href="/"><span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>VoxCRM</a>
<button class="btn crm-menu-button d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Menüyü aç"><i class="bi bi-list"></i></button>
<form action="/Patient" method="get" class="crm-global-search d-none d-md-flex" role="search"><i class="bi bi-search"></i><input name="search" type="search" aria-label="Hasta, sahip veya telefon ara" placeholder="Hasta, sahip veya telefon ara…"><button type="submit" class="visually-hidden">Ara</button></form>
<div class="crm-top-actions"><span class="crm-clinic-name d-none d-lg-inline"><i class="bi bi-building"></i> @await Component.InvokeAsync("ClinicHeader")</span>@if(await Modules.WorkdayAsync()){<a class="crm-icon-button" href="/Workday#closing" aria-label="Takip ve kapanış uyarıları" title="Takip ve kapanış uyarıları"><i class="bi bi-bell"></i></a>}
<div class="dropdown"><button class="crm-profile" data-bs-toggle="dropdown" type="button" aria-expanded="false" aria-label="Hesap menüsü">@profile[..1].ToUpperInvariant()</button><ul class="dropdown-menu dropdown-menu-end"><li class="dropdown-header text-truncate">@profile</li><li><a class="dropdown-item" href="/Auth/ChangePassword"><i class="bi bi-shield-lock me-2"></i>Hesap güvenliği</a></li><li><hr class="dropdown-divider"></li><li><form method="post" action="/Auth/Logout">@Html.AntiForgeryToken()<button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button></form></li></ul></div>
</div></header>
<div class="container-fluid"><div class="row"><nav id="sidebarMenu" class="sidebar collapse d-md-block crm-sidebar" aria-label="Ana menü"><div class="sidebar-sticky">
<div class="crm-nav-section">ÇALIŞMA ALANI</div><ul class="nav flex-column">
<li><a class="nav-link @(active == "dashboard" ? "active" : "")" href="/"><i class="bi bi-grid-1x2"></i>Bugün</a></li>
<li><a class="nav-link @(active == "patients" ? "active" : "")" href="/Patient"><i class="bi bi-heart-pulse"></i>Hastalar</a></li>
<li><a class="nav-link @(active == "petowners" ? "active" : "")" href="/PetOwner"><i class="bi bi-people"></i>Müşteriler</a></li>
<li><a class="nav-link @(active == "appointments" ? "active" : "")" href="/Appointment"><i class="bi bi-calendar3"></i>Randevular</a></li>
<li><a class="nav-link @(active == "muayeneler" ? "active" : "")" href="/Muayene"><i class="bi bi-clipboard2-pulse"></i>Muayeneler</a></li>
@if(await Modules.WorkdayAsync()){<li><a class="nav-link @(active == "workday" ? "active" : "")" href="/Workday"><i class="bi bi-check2-square"></i>Görevler / Kapanış</a></li>}
<li><a class="nav-link @(active == "finance" ? "active" : "")" href="/Finance"><i class="bi bi-wallet2"></i>Tahsilat</a></li>
@if(await Modules.QuickVisitAsync()){<li><a class="nav-link @(active == "quickvisit" ? "active" : "")" href="/QuickVisit"><i class="bi bi-mic"></i>Hızlı Ziyaret</a></li>}
<li><a class="nav-link @(active == "excel" ? "active" : "")" href="/ExcelTransfer"><i class="bi bi-file-earmark-excel"></i>Excel Aktarım</a></li>
@if(await Modules.FollowUpAsync()){<li><a class="nav-link @(active == "ownerfollowup" ? "active" : "")" href="/OwnerFollowUp"><i class="bi bi-heart"></i>Hasta Sahibi Takibi</a></li>}
@if(await Modules.WhatsAppAsync()){<li><a class="nav-link @(active == "whatsapp" ? "active" : "")" href="/WhatsApp"><i class="bi bi-whatsapp"></i>WhatsApp</a></li>}
</ul><div class="crm-nav-section mt-4">KLİNİK YÖNETİMİ</div><ul class="nav flex-column">
<li><a class="nav-link @(active == "vaccines" ? "active" : "")" href="/Vaccination"><i class="bi bi-calendar2-heart"></i>Aşı takvimi</a></li>
<li><a class="nav-link @(active == "vaccinetypes" ? "active" : "")" href="/VaccineType"><i class="bi bi-capsule"></i>Aşı tanımları</a></li>
<li><a class="nav-link @(active == "services" ? "active" : "")" href="/ServiceItem"><i class="bi bi-tags"></i>Hizmet kataloğu</a></li>
<li><span class="nav-link crm-unavailable" aria-disabled="true" title="Stok modülü henüz etkin değil"><i class="bi bi-box-seam"></i>Stok <small>Yakında</small></span></li>
</ul><div class="crm-sidebar-footer"><a class="nav-link" href="/Auth/ChangePassword"><i class="bi bi-gear"></i>Hesap güvenliği</a><span>VoxCRM · Klinik çalışma alanı</span></div>
</div></nav><main class="crm-main">@RenderBody()</main></div></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/crm-shell.js" asp-append-version="true"></script><script src="~/js/app-toast.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>